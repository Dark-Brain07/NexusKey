# =============================================================================
# NexusKey — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env (root, for local tooling) and to apps/web/.env.local
# and apps/api/.env as needed. Never commit a real .env file — .gitignore
# already excludes them.
#
# Variables are grouped by where they are consumed and whether they are
# safe to expose to the browser. NEXT_PUBLIC_* variables are bundled into
# the client JS and are NOT secret. Everything else must stay server-only.
# =============================================================================

# --- Shared / general ---------------------------------------------------
NODE_ENV=development

# --- GenLayer (public — the frontend reads the contract directly) -------
# Network identifier for GenLayer Studio's StudioNet.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet
# StudioNet JSON-RPC endpoint. Get this from your GenLayer Studio instance.
NEXT_PUBLIC_GENLAYER_RPC_URL=
# Set ONLY after you deploy the NexusKey Intelligent Contract and provide the
# address. Left blank, the app runs in a documented "contract not configured"
# state rather than pointing at an invented address.
NEXT_PUBLIC_NexusKey_CONTRACT_ADDRESS=

# --- Frontend (public) ---------------------------------------------------
# Local dev default shown. Production Vercel deployment uses:
#   NEXT_PUBLIC_APP_URL=https://NexusKey.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Backend API (server-only) -------------------------------------------
PORT=8080
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres — local Docker Compose default shown; replace for Fly.io deploys
# with the DATABASE_URL Fly generates for the attached Postgres app.
DATABASE_URL=postgresql://NexusKey:NexusKey_dev_password@localhost:5544/NexusKey

# GenLayer RPC used server-side by the indexer (same network as above; kept
# separate so the indexer can point at a different node/API-key tier than
# the browser client if needed).
GENLAYER_RPC_URL=
NexusKey_CONTRACT_ADDRESS=

# Backend evidence-preview fetcher (off-chain cache only, see Stage 2 design)
EVIDENCE_FETCH_TIMEOUT_MS=8000
EVIDENCE_FETCH_MAX_BYTES=2000000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Monitoring / observability (server-only, optional) -------------------
LOG_LEVEL=info
MONITORING_DSN=

# --- Wallet-based auth (public) --------------------------------------------
# WalletConnect / RainbowKit project ID for wallet-connection UI.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Session signing — server-only secret used to sign short-lived session
# tokens issued after a successful SIWE-style wallet signature verification.
AUTH_SESSION_SECRET=
